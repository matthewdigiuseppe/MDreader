{
  "name": "MDreader",
  "short_name": "MDreader",
  "description": "A distraction-free, live-preview markdown reader and editor for academics.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbfaf7",
  "theme_color": "#fbfaf7",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": { "text/markdown": [".md", ".markdown", ".mdown", ".mkd"] }
    }
  ]
}
